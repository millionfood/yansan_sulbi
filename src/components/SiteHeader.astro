---
import { yangsanSulbi as site } from "../site/config";

const nav = site.nav ?? [];
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="site-header__brand display" href="/" aria-label={`${site.copy.brand} 홈`}>
      {site.copy.brand}
    </a>

    {
      nav.length > 0 && (
        <nav class="site-header__nav" aria-label="페이지 내 이동">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class={`site-header__actions${nav.length === 0 ? " site-header__actions--compact" : ""}`}>
      <a class="site-header__phone" href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
      <a class="site-header__cta btn btn-primary" href="#inquiry">{site.copy.ctaPrimary}</a>
      {
        nav.length > 0 && (
          <button
            type="button"
            class="site-header__menu"
            data-nav-toggle
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            메뉴
          </button>
        )
      }
    </div>
  </div>

  {
    nav.length > 0 && (
      <div class="site-header__drawer" id="mobile-nav" data-nav-drawer hidden>
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href} data-nav-link>
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
          </li>
        </ul>
      </div>
    )
  }
</header>

<script>
  const header = document.querySelector("[data-site-header]");
  const toggle = document.querySelector("[data-nav-toggle]");
  const drawer = document.querySelector("[data-nav-drawer]");

  if (header instanceof HTMLElement) {
    const onScroll = () => {
      header.dataset.scrolled = window.scrollY > 12 ? "true" : "false";
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  if (toggle instanceof HTMLButtonElement && drawer instanceof HTMLElement) {
    const setOpen = (open) => {
      drawer.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(drawer.hidden);
    });

    drawer.querySelectorAll("[data-nav-link]").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    padding: 0.85rem 0;
    color: var(--header-fg, var(--color-text));
    background: transparent;
    transition:
      background 0.25s ease,
      box-shadow 0.25s ease,
      backdrop-filter 0.25s ease;
  }

  .site-header[data-scrolled="true"] {
    background: var(--header-bg, rgba(255, 255, 255, 0.9));
    backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 var(--color-line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-header__brand {
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .site-header__nav {
    display: none;
  }

  .site-header__nav ul {
    display: flex;
    gap: 1.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  .site-header__nav a:hover {
    color: var(--color-text);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .site-header__phone {
    display: none;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .site-header__cta {
    display: none;
    min-height: 2.5rem;
    padding: 0.45rem 0.95rem;
    font-size: 0.9rem;
  }

  .site-header__actions--compact .site-header__phone,
  .site-header__actions--compact .site-header__cta {
    display: flex;
  }

  .site-header__menu {
    border: 1px solid var(--color-line);
    background: var(--color-bg-elevated);
    color: inherit;
    border-radius: 0.35rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  .site-header__drawer {
    border-top: 1px solid var(--color-line);
    background: var(--color-bg-elevated);
    margin-top: 0.75rem;
  }

  .site-header__drawer ul {
    list-style: none;
    margin: 0;
    padding: 0.75rem 1.25rem 1rem;
    display: grid;
    gap: 0.65rem;
  }

  .site-header__drawer a {
    text-decoration: none;
    font-weight: 600;
  }

  @media (min-width: 880px) {
    .site-header__nav,
    .site-header__phone,
    .site-header__cta {
      display: flex;
    }

    .site-header__menu,
    .site-header__drawer {
      display: none !important;
    }
  }

  @media (min-width: 880px) and (max-width: 1040px) {
    .site-header__nav a {
      font-size: 0.88rem;
    }

    .site-header__nav ul {
      gap: 0.85rem;
    }

    .site-header__phone {
      display: none;
    }

    .site-header__actions--compact .site-header__phone {
      display: flex;
    }
  }
</style>
